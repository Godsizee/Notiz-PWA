{
  "id": "/",
  "name": "B&B Notes",
  "short_name": "B&B Notes",
  "description": "Geteilte Notizen und Checklisten für zwei",
  "start_url": "/",
  "scope": "/",
  "display": "fullscreen",
  "display_override": ["fullscreen", "standalone", "minimal-ui"],
  "orientation": "portrait",
  "background_color": "#0b0717",
  "theme_color": "#390099",
  "lang": "de",
  "categories": ["productivity", "utilities"],
  "prefer_related_applications": false,
  "shortcuts": [
    {
      "name": "Neue Notiz",
      "short_name": "Notiz",
      "description": "Direkt eine neue Textnotiz erstellen",
      "url": "/?new=text",
      "icons": [{ "src": "/icon-192x192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Neue Liste",
      "short_name": "Liste",
      "description": "Direkt eine neue Checkliste erstellen",
      "url": "/?new=checklist",
      "icons": [{ "src": "/icon-192x192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ],
  "share_target": {
    "action": "/share",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "icons": [
    {
      "src": "/icon-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
