# Vorlage fuer die lokale Konfiguration.
#
#   cp .env.example .env
#
# Bewusst `.env` und nicht `.env.local`: Next.js liest beide, `docker compose`
# aber nur `.env`. Eine Datei reicht damit fuer App und Container. Alle
# `.env*`-Dateien ausser dieser Vorlage sind gitignored.

# ---------------------------------------------------------------------------
# PocketBase
# ---------------------------------------------------------------------------

# URL der PocketBase-Instanz, wie sie der BROWSER erreicht.
# Landet im Client-Bundle und im generierten Service Worker (next.config.mjs
# baut daraus die Workbox-Caching-Regeln und die CSP) — also nichts Geheimes
# hier ablegen. Pflichtangabe: ohne sie bricht der Build ab, statt still auf
# eine fremde Instanz zu zeigen.
NEXT_PUBLIC_POCKETBASE_URL=http://localhost:8090

# URL derselben Instanz, wie sie der SERVER erreicht (Route Handlers, SSR).
# Im Docker-Netz ist das der Servicename, nicht localhost.
POCKETBASE_URL=http://localhost:8090

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------

# Oeffentliche Basis-URL der App. Wird fuer den Redirect des Android
# Share-Targets gebraucht (src/app/share-target/route.ts).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# PocketBase-Superuser (nur fuer docker-compose / Erstinitialisierung)
# ---------------------------------------------------------------------------
# Wird beim ersten Start des PocketBase-Containers als Admin-Konto angelegt.
# NIEMALS mit echten Werten committen — diese Datei ist nur die Vorlage.
PB_SUPERUSER_EMAIL=admin@example.com
PB_SUPERUSER_PASSWORD=changeme-mindestens-10-zeichen

# ---------------------------------------------------------------------------
# Registrierung
# ---------------------------------------------------------------------------

# Kommagetrennte Allowlist fuer /api/register. Leer oder nicht gesetzt heisst:
# Registrierung geschlossen — Konten legt man dann im PocketBase-Admin an.
# Bewusst nicht im Quelltext: dort waeren es die privaten Adressen realer
# Personen in einem oeffentlichen Repository.
REGISTRATION_ALLOWED_EMAILS=

# ---------------------------------------------------------------------------
# Optionale Startkonten (nur beim ersten Start eines frischen PocketBase)
# ---------------------------------------------------------------------------
# Legt die genannten Konten mit erzwungenem Passwortwechsel an. Beide Variablen
# noetig, Passwort mindestens 8 Zeichen — sonst passiert nichts.
PB_INITIAL_USER_EMAILS=
PB_INITIAL_USER_PASSWORD=
